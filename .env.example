# Supabase Dashboard > Project Settings > API에서 확인합니다.

NEXT_PUBLIC_SUPABASE_URL=
# 신규 프로젝트는 Publishable Key 사용을 권장합니다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 기존 프로젝트의 anon key를 쓸 때만 위 항목 대신 입력합니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 인터뷰 예약 확정·변경·취소 알림을 전달할 발송 서비스 웹훅입니다.
# interview.rescheduled/cancelled 이벤트도 처리해야 합니다.
INTERVIEW_CONFIRMATION_WEBHOOK_URL=
INTERVIEW_CONFIRMATION_WEBHOOK_TOKEN=

# 배포 사이트의 대표 주소입니다. 커스텀 도메인을 연결하면 해당 주소로 변경하세요.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 로그인 화면에서 admin 아이디를 사용할 때 연결할 실제 관리자 이메일입니다.
# NEXT_PUBLIC_ 접두사를 붙이지 않아 브라우저에 노출되지 않게 합니다.
ADMIN_LOGIN_EMAIL=

# 인터뷰 예약·변경·취소를 운영자에게 이메일로 알립니다. 키나 수신 주소가 없으면 발송하지 않습니다.
# resend.dev는 테스트용이며 Resend 가입 이메일로만 보낼 수 있습니다.
RESEND_API_KEY=
INTERVIEW_ADMIN_EMAIL=readmebook.team@gmail.com
INTERVIEW_ADMIN_EMAIL_FROM="READ ME <onboarding@resend.dev>"
INTERVIEW_ADMIN_SITE_URL=https://read-me-two-black.vercel.app
