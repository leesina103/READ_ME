# 이 파일을 .env.operations.local로 복사하고 비밀값을 로컬에서만 입력하세요.
# Supabase 기본 URL·서비스 키는 Edge Function에 자동 제공됩니다.
OPS_ENABLED=false
OPS_CRON_SECRET=
OPS_MONITOR_SECRET=
OPS_NOTION_TOKEN=
OPS_RESEND_API_KEY=
OPS_MAIL_FROM=
OPS_MAIL_TO=
# 과거 예약을 소급 처리하지 않도록 실제 전환 시각을 ISO 형식으로 입력합니다.
OPS_START_AT=
OPS_GOOGLE_CLIENT_ID=
OPS_GOOGLE_CLIENT_SECRET=
OPS_GOOGLE_REFRESH_TOKEN=
